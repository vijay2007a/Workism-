{
  "name": "workism",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "node --env-file-if-exists=.env.local server/dev-server.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\" \"server/**/*.test.ts\"",
    "test:frontend": "node --test \"src/**/*.test.ts\"",
    "test:backend": "node --test \"server/**/*.test.ts\"",
    "scan:secrets": "node scripts/secret-scan.ts --all",
    "scan:staged": "node scripts/secret-scan.ts --staged",
    "scan:dist": "node scripts/secret-scan.ts --dist"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@google/genai": "^3.6.1",
    "@supabase/supabase-js": "^2.119.2",
    "clsx": "^2.1.1",
    "lucide-react": "^1.77.0",
    "motion": "^14.14.0",
    "ogl": "^1.0.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2",
    "recharts": "^3.11.0",
    "tailwind-merge": "^3.7.1",
    "uqr": "^0.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "oxlint": "^1.94.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
