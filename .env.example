# ==============================================================================
# WORKISM 3.0 Environment Configuration Example
# Copy to .env.local for local development. NEVER commit .env or .env.local.
# ==============================================================================

# --- Public Client Variables (exposed to Vite browser bundle) -----------------
# Supabase project URL (public)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase publishable / anon key (public, RLS-restricted)
VITE_SUPABASE_PUBLISHABLE_KEY=replace_with_supabase_publishable_key
# Optional API base URL (leave empty on Vercel to use same-origin /api)
VITE_API_URL=

# --- Private Server-Only Variables (NEVER prefix with VITE_) ------------------
# Supabase server URL (defaults to VITE_SUPABASE_URL if omitted)
SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase publishable key for RLS-scoped server requests
SUPABASE_PUBLISHABLE_KEY=replace_with_supabase_publishable_key
# Supabase secret / service-role key (PRIVILEGED — server-only, bypasses RLS)
SUPABASE_SECRET_KEY=replace_with_supabase_secret_key
# Direct PostgreSQL connection string for running SQL migrations (server-only)
DATABASE_URL=postgresql://postgres:replace_me@db.your-project-ref.supabase.co:5432/postgres

# Google Gemini API key (server-only)
GEMINI_API_KEY=replace_with_gemini_api_key
# Optional Gemini model override (defaults to stable gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

# Cryptographic HMAC-SHA256 signing secret for verifiable certificates (min 32 chars)
CERTIFICATE_SIGNING_SECRET=replace_with_at_least_32_random_characters_secret

# Comma-separated allowed browser origins for strict CORS (e.g. https://workism.vercel.app)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional isolated external code execution service (never runs inside Vercel)
CODE_EXECUTION_URL=
CODE_EXECUTION_TOKEN=

# Optional daily AI quota per user (defaults to 40 requests/day)
AI_DAILY_QUOTA=40
